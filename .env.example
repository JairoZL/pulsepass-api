# Plantilla de variables de entorno (PRD Seguridad §14.2). Sin secretos reales.
# Copia este archivo como .env en la raíz del proyecto y completa la clave.
# .env está en .gitignore: NUNCA lo subas al repositorio.
#
# Generar una clave aleatoria de 32 bytes en PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

PULSEPASS_JWT_SECRET_BASE64=
PULSEPASS_JWT_ISSUER=pulsepass-api

# Cuentas demo, solo con el perfil dev (PRD Seguridad §9.2 y §23). Mínimo 12 caracteres.
# Vacías = esa cuenta no se crea.
#   laura -> USER + STAFF      admin -> USER + ADMIN
PULSEPASS_DEMO_STAFF_PASSWORD=
PULSEPASS_DEMO_ADMIN_PASSWORD=
